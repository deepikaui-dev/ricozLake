# ==========================================
# RicozLake Root .gitignore
# ==========================================

# 1. Environment variables and secrets (CRITICAL)
.env
.env.*
.env.local
.env.production
**/.env
**/.env.*
**/.env.local
**/.env.production
!**/.env.example

# 2. Dependencies
node_modules/
**/node_modules/

# 3. Production build artifacts
dist/
**/dist/
dist-ssr/
**/dist-ssr/

# 4. Uploaded files & temporary storage
uploads/*
!uploads/.gitkeep
**/uploads/*
!**/uploads/.gitkeep

# 5. Local database files
*.db
*.sqlite
dev.db
**/dev.db

# 6. Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 7. Agent & IDE directories
.agents/
.claude/
.windsurf/
skills-lock.json

# 8. OS and Editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
